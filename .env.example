# Opcional. Copia este archivo a .env para cambiar la URL publica del sitio.
# El build usa esta URL para la imagen que aparece al compartir en redes.
# D1 se conecta mediante el binding DB de wrangler.jsonc; no necesita contrasena.
# Los secretos del backend (MASTER_KEY, SETUP_TOKEN) NO van aqui: se generan con
# "npm run secretos:local" (.dev.vars) y "npm run secretos:produccion" (Cloudflare).
SITE_URL=https://sermasclubnatacion.xjuancho16.workers.dev
