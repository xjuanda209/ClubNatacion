{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sermasclubnatacion",
  "account_id": "649998aad1a7c374fbcd7820e820c434",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "assets": {
