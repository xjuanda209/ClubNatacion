{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sermasclubnatacion",
  "main": "./src/worker.mjs",
  "account_id": "649998aad1a7c374fbcd7820e820c434",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sermasclubnatacion-db",
      "database_id": "a275598c-c0c0-48fe-a297-f1b78fb47c9e",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "build": {
    "command": "npm run build",
    "watch_dir": "./public"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  }
}
